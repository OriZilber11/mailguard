{
  "timeZone": "Etc/UTC",
  "runtimeVersion": "V8",
  "exceptionLogging": "STACKDRIVER",
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.message.readonly",
    "https://www.googleapis.com/auth/script.external_request",
    "openid",
    "https://www.googleapis.com/auth/userinfo.email"
  ],
  "urlFetchWhitelist": ["https://traction-rerun-preface.ngrok-free.dev/"],
  "addOns": {
    "common": {
      "name": "MailGuard",
      "logoUrl": "https://www.gstatic.com/images/icons/material/system/1x/security_black_24dp.png"
    },
    "gmail": {
      "contextualTriggers": [
        { "unconditional": {}, "onTriggerFunction": "onOpenMessage" }
      ]
    }
  }
}
